// ==================== MESAJ & SEVİYE & PARTNER KORUMA & PREFIX KOMUTLARI ====================
client.on('messageCreate', async message => {
  if (message.author.bot || !message.guild) return;

  const partnerChannel = resolveChannel(message.guild, CONFIG.CHANNELS.PARTNER_ID, ['partnerler']);
  const isInPartnerChannel = partnerChannel && message.channel.id === partnerChannel.id;
  const isPrefixCommand = message.content.startsWith(CONFIG.PREFIX);

  // --- Partnerler Kanalında Blacklist Kontrolü & Doğrudan Duyuru Yakalama ---
  if (isInPartnerChannel) {
    const blockedTerm = findBlacklistedTerm(message.guild.id, message.content);
    if (blockedTerm) {
      await message.delete().catch(() => {});
      const warnMsg = await message.channel.send(
        `🚫 ${message.author}, **\`${blockedTerm}\`** blacklist'te bulunduğu için bu partner duyurusu/linki engellendi!`
      );
      setTimeout(() => warnMsg.delete().catch(() => {}), 6000);
      await sendPartnerLog(
        message.guild,
        '🚫 Blacklist Engellendi',
        `**Kullanıcı:** ${message.author.tag} (\`${message.author.id}\`)\n**Eşleşen Kayıt:** \`${blockedTerm}\`\n**İçerik:** ${message.content}`,
        '#E74C3C'
      );
      return;
    }

    if (!isPrefixCommand && /(discord\.gg\/|discord\.com\/invite\/|https?:\/\/)/i.test(message.content)) {
      const content = message.content.trim();
      await message.delete().catch(() => {});
      const stats = recordPartnerAndGetStats(message.guild.id, message.author.id);
      const embed = buildPartnerAnnouncementEmbed(message.author, content, stats);
      await message.channel.send({ embeds: [embed] });
      await sendPartnerLog(
        message.guild,
        '🤝 Partner Duyurusu Paylaşıldı',
        `**Yetkili:** ${message.author.tag}\n**Bugün/Hafta/Ay:** ${stats.today}/${stats.week}/${stats.month}\n**İçerik:** ${content}`
      );
      return;
    }
  }

  // --- Otomatik XP / Seviye Sistemi ---
  const userXP = getXP(message.author.id);
  userXP.xp += Math.floor(Math.random() * 10) + 5;
  const needed = userXP.level * 100;
  if (userXP.xp >= needed) {
    userXP.xp -= needed;
    userXP.level += 1;
    message.channel
      .send(`🎉 Tebrikler ${message.author}, **Seviye ${userXP.level}** oldun!`)
      .then(m => setTimeout(() => m.delete().catch(() => {}), 5000));
  }

  // --- Prefix Kontrolü ---
  if (!isPrefixCommand) return;
  const args = message.content.slice(CONFIG.PREFIX.length).trim().split(/\s+/);
  const cmd = args.shift()?.toLowerCase();
  if (!cmd) return;

  try {
    // PARTNER KOMUTU
    if (cmd === 'partner') {
      const content = args.join(' ').trim();
      if (!content) return message.reply('❌ Kullanım: `v!partner <duyuru metni ve sunucu linki>`');

      const blockedTerm = findBlacklistedTerm(message.guild.id, content);
      if (blockedTerm) {
        await sendPartnerLog(
          message.guild,
          '🚫 Blacklist Engellendi (v!partner)',
          `**Kullanıcı:** ${message.author.tag}\n**Eşleşen Kayıt:** \`${blockedTerm}\`\n**İçerik:** ${content}`,
          '#E74C3C'
        );
        return message.reply(`🚫 **\`${blockedTerm}\`** blacklist'te yer aldığı için bu partner gönderilemez!`);
      }

      const targetCh = partnerChannel || message.channel;
      const stats = recordPartnerAndGetStats(message.guild.id, message.author.id);
      const embed = buildPartnerAnnouncementEmbed(message.author, content, stats);
      await targetCh.send({ embeds: [embed] });
      await sendPartnerLog(
        message.guild,
        '🤝 Partner Duyurusu (v!partner)',
        `**Yetkili:** ${message.author.tag}\n**Bugün/Hafta/Ay:** ${stats.today}/${stats.week}/${stats.month}\n**İçerik:** ${content}`
      );
      if (targetCh.id !== message.channel.id) {
        return message.reply(
          `✅ Partner duyurusu ${targetCh} kanalına gönderildi! (Bugün: **${stats.today}** | Bu Hafta: **${stats.week}** | Bu Ay: **${stats.month}**)`
        );
      }
      return;
    }

    // KALICI PARTNER KOMUTU (SADECE YÖNETİCİ)
    if (cmd === 'kalici-partner' || cmd === 'kalicipartner') {
      if (!message.member.permissions.has(PermissionFlagsBits.Administrator)) {
        return message.reply('❌ Bu komutu yalnızca **Yöneticiler** kullanabilir.');
      }
      const content = args.join(' ').trim();
      if (!content) return message.reply('❌ Kullanım: `v!kalici-partner <duyuru metni ve sunucu linki>`');

      const kaliciCh = resolveChannel(message.guild, CONFIG.CHANNELS.KALICI_ID, ['kalıcı', 'kalici']);
      if (!kaliciCh) {
        return message.reply('❌ Sunucuda `kalıcı` kanalı bulunamadı.');
      }

      const embed = buildPermanentPartnerEmbed(message.author, content);
      await kaliciCh.send({ embeds: [embed] });
      await sendPartnerLog(
        message.guild,
        '💎 Kalıcı Partner Eklendi',
        `**Yönetici:** ${message.author.tag}\n**Kanal:** ${kaliciCh}\n**İçerik:** ${content}`,
        '#F1C40F'
      );
      return message.reply(`✅ Kalıcı partner mesajı ${kaliciCh} kanalına modern embed ile gönderildi.`);
    }

    // BLACKLIST EKLE
    if (cmd === 'blacklist-ekle' || cmd === 'blekle') {
      if (!message.member.permissions.has(PermissionFlagsBits.ManageGuild) && !message.member.permissions.has(PermissionFlagsBits.Administrator)) {
        return message.reply('❌ Blacklist yönetmek için yetkin yok.');
      }
      const term = args.join(' ').trim().toLowerCase();
      if (!term) return message.reply('❌ Kullanım: `v!blacklist-ekle <sunucu ismi veya link>`');

      getBlacklist(message.guild.id).add(term);

      const blCh = resolveChannel(message.guild, CONFIG.CHANNELS.BLACKLIST_ID, ['blacklist']);
      if (blCh) {
        const blEmbed = new EmbedBuilder()
          .setColor('#E74C3C')
          .setTitle('⛔ Blacklist Kaydı Eklendi')
          .addFields(
            { name: 'Engellenen İsim / Link', value: `\`${term}\``, inline: true },
            { name: 'Ekleyen Yetkili', value: `${message.author.tag}`, inline: true }
          )
          .setTimestamp();
        await blCh.send({ embeds: [blEmbed] }).catch(() => {});
      }

      return message.reply(`⛔ **\`${term}\`** blacklist'e eklendi. Artık \`partnerler\` kanalında engellenecek.`);
    }

    // BLACKLIST KALDIR
    if (cmd === 'blacklist-kaldir' || cmd === 'blkaldir') {
      if (!message.member.permissions.has(PermissionFlagsBits.ManageGuild) && !message.member.permissions.has(PermissionFlagsBits.Administrator)) {
        return message.reply('❌ Blacklist yönetmek için yetkin yok.');
      }
      const term = args.join(' ').trim().toLowerCase();
      if (!term) return message.reply('❌ Kullanım: `v!blacklist-kaldir <sunucu ismi veya link>`');
      const removed = getBlacklist(message.guild.id).delete(term);
      return message.reply(removed ? `✅ **\`${term}\`** blacklist'ten kaldırıldı.` : '❌ Bu kayıt blacklist\'te bulunamadı.');
    }

    // BLACKLIST LİSTE
    if (cmd === 'blacklist-liste' || cmd === 'blliste') {
      const list = [...getBlacklist(message.guild.id)];
      if (!list.length) return message.reply('📋 Blacklist şu an boş.');
      const embed = new EmbedBuilder()
        .setColor('#E74C3C')
        .setTitle('📋 Sunucu Blacklist Listesi')
        .setDescription(list.map((item, idx) => `**${idx + 1}.** \`${item}\``).join('\n'));
      return message.reply({ embeds: [embed] });
    }

    // MODERN EMBED (v!embed Başlık | Açıklama | #Renk | GörselURL)
    if (cmd === 'embed') {
      const raw = args.join(' ');
      const [title, desc, colorInput, imageInput] = raw.split('|').map(s => s?.trim());
      if (!title || !desc) {
        return message.reply('❌ Kullanım: `v!embed Başlık | Açıklama | #5865F2 | GörselURL(opsiyonel)`');
      }
      const embed = buildModernEmbed({
        title,
        description: desc,
        color: colorInput,
        author: message.author,
        guildName: message.guild.name,
        image: imageInput,
      });
      return message.channel.send({ embeds: [embed] });
    }

    // HELP
    if (cmd === 'help' || cmd === 'yardim') {
      return message.reply(buildHelpUI());
    }

    // PING
    if (cmd === 'ping') {
      const sent = await message.reply('🏓 Ölçülüyor...');
      return sent.edit(
        `🏓 **Viserion Gecikme:** Mesaj \`${sent.createdTimestamp - message.createdTimestamp}ms\` | API \`${Math.round(client.ws.ping)}ms\``
      );
    }

    // AVATAR
    if (cmd === 'avatar' || cmd === 'av') {
      const user = message.mentions.users.first() || message.author;
      const embed = new EmbedBuilder()
        .setColor(CONFIG.COLOR)
        .setTitle(`${user.username} Avatarı`)
        .setImage(user.displayAvatarURL({ dynamic: true, size: 512 }));
      return message.reply({ embeds: [embed] });
    }

    // USERINFO
    if (cmd === 'userinfo' || cmd === 'ui') {
      const user = message.mentions.users.first() || message.author;
      const member = await message.guild.members.fetch(user.id).catch(() => null);
      const embed = new EmbedBuilder()
        .setColor(CONFIG.COLOR)
        .setAuthor({ name: user.tag, iconURL: user.displayAvatarURL() })
        .setThumbnail(user.displayAvatarURL({ dynamic: true }))
        .addFields(
          { name: 'ID', value: `\`${user.id}\``, inline: true },
          { name: 'Hesap Tarihi', value: `<t:${Math.floor(user.createdTimestamp / 1000)}:R>`, inline: true },
          {
            name: 'Katılım Tarihi',
            value: member?.joinedTimestamp ? `<t:${Math.floor(member.joinedTimestamp / 1000)}:R>` : 'Yok',
            inline: true,
          }
        );
      return message.reply({ embeds: [embed] });
    }

    // SERVERINFO
    if (cmd === 'serverinfo' || cmd === 'si') {
      const g = message.guild;
      const embed = new EmbedBuilder()
        .setColor(CONFIG.COLOR)
        .setTitle(`🏰 ${g.name}`)
        .setThumbnail(g.iconURL({ dynamic: true }))
        .addFields(
          { name: 'Üye Sayısı', value: `\`${g.memberCount}\``, inline: true },
          { name: 'Kanal Sayısı', value: `\`${g.channels.cache.size}\``, inline: true },
          { name: 'Rol Sayısı', value: `\`${g.roles.cache.size}\``, inline: true },
          { name: 'Kuruluş', value: `<t:${Math.floor(g.createdTimestamp / 1000)}:D>`, inline: true }
        );
      return message.reply({ embeds: [embed] });
    }

    // CLEAR
    if (cmd === 'clear' || cmd === 'sil') {
      if (!message.member.permissions.has(PermissionFlagsBits.ManageMessages))
        return message.reply('❌ **Mesajları Yönet** yetkin yok.');
      const count = parseInt(args[0], 10);
      if (!count || count < 1 || count > 100) return message.reply('❌ Kullanım: `v!clear <1-100>`');
      const deleted = await message.channel.bulkDelete(count, true);
      const m = await message.channel.send(`🧹 **${deleted.size}** mesaj temizlendi.`);
      return setTimeout(() => m.delete().catch(() => {}), 3000);
    }

    // BAN
    if (cmd === 'ban') {
      if (!message.member.permissions.has(PermissionFlagsBits.BanMembers))
        return message.reply('❌ **Üyeleri Yasakla** yetkin yok.');
      const target = message.mentions.members.first();
      if (!target) return message.reply('❌ Kullanım: `v!ban @kullanici [sebep]`');
      if (!target.bannable) return message.reply('❌ Bu kullanıcıyı yasaklayamıyorum.');
      const reason = args.slice(1).join(' ') || 'Sebep belirtilmedi';
      await target.ban({ reason });
      await sendLog(message.guild, '🔨 Kullanıcı Yasaklandı', `**Hedef:** ${target.user.tag}\n**Yetkili:** ${message.author.tag}\n**Sebep:** ${reason}`);
      return message.reply(`🔨 **${target.user.tag}** yasaklandı. Sebep: *${reason}*`);
    }

    // KICK
    if (cmd === 'kick') {
      if (!message.member.permissions.has(PermissionFlagsBits.KickMembers))
        return message.reply('❌ **Üyeleri At** yetkin yok.');
      const target = message.mentions.members.first();
      if (!target) return message.reply('❌ Kullanım: `v!kick @kullanici [sebep]`');
      if (!target.kickable) return message.reply('❌ Bu kullanıcıyı atamıyorum.');
      const reason = args.slice(1).join(' ') || 'Sebep belirtilmedi';
      await target.kick(reason);
      await sendLog(message.guild, '👢 Kullanıcı Atıldı', `**Hedef:** ${target.user.tag}\n**Yetkili:** ${message.author.tag}\n**Sebep:** ${reason}`);
      return message.reply(`👢 **${target.user.tag}** sunucudan atıldı. Sebep: *${reason}*`);
    }

    // WARN
    if (cmd === 'warn' || cmd === 'uyar') {
      if (!message.member.permissions.has(PermissionFlagsBits.ModerateMembers))
        return message.reply('❌ Yetkin yetersiz.');
      const target = message.mentions.users.first();
      const reason = args.slice(1).join(' ');
      if (!target || !reason) return message.reply('❌ Kullanım: `v!warn @kullanici <sebep>`');
      const key = `${message.guild.id}_${target.id}`;
      const list = db.warnings.get(key) || [];
      list.push({ reason, mod: message.author.tag, date: new Date().toLocaleDateString('tr-TR') });
      db.warnings.set(key, list);
      return message.reply(`⚠️ **${target.tag}** uyarıldı! (Toplam Uyarı: **${list.length}**) — Sebep: *${reason}*`);
    }

    // RANK
    if (cmd === 'rank' || cmd === 'seviye') {
      const target = message.mentions.users.first() || message.author;
      const data = getXP(target.id);
      const embed = new EmbedBuilder()
        .setColor('#9B59B6')
        .setTitle(`📈 ${target.username} Seviye Kartı`)
        .addFields(
          { name: 'Seviye', value: `\`${data.level}\``, inline: true },
          { name: 'XP', value: `\`${data.xp} / ${data.level * 100}\``, inline: true }
        );
      return message.reply({ embeds: [embed] });
    }

    // BALANCE
    if (cmd === 'balance' || cmd === 'bakiye' || cmd === 'bal') {
      const eco = getEco(message.author.id);
      return message.reply(`💰 Cüzdan bakiyen: **${eco.balance} Viserion Coin**`);
    }

    // DAILY
    if (cmd === 'daily' || cmd === 'gunluk') {
      const eco = getEco(message.author.id);
      const now = Date.now();
      const cooldown = 24 * 60 * 60 * 1000;
      if (now - eco.lastDaily < cooldown) {
        const kalanSaat = Math.ceil((cooldown - (now - eco.lastDaily)) / (1000 * 60 * 60));
        return message.reply(`⏳ Günlük ödülünü zaten aldın! **${kalanSaat} saat** sonra tekrar dene.`);
      }
      eco.balance += 250;
      eco.lastDaily = now;
      return message.reply(`🎁 Günlük **250 Viserion Coin** hesabına eklendi! Yeni bakiye: **${eco.balance}**`);
    }

    // COINFLIP
    if (cmd === 'coinflip' || cmd === 'cf') {
      const amount = parseInt(args[0], 10);
      const eco = getEco(message.author.id);
      if (!amount || amount < 10) return message.reply('❌ Kullanım: `v!cf <miktar>` (En az 10)');
      if (eco.balance < amount) return message.reply('❌ Yetersiz bakiye!');
      const win = Math.random() < 0.5;
      if (win) {
        eco.balance += amount;
        return message.reply(`🪙 Kazandın! **+${amount}** coin. Güncel bakiye: **${eco.balance}**`);
      } else {
        eco.balance -= amount;
        return message.reply(`🪙 Kaybettin! **-${amount}** coin. Güncel bakiye: **${eco.balance}**`);
      }
    }

    // TICKET KUR
    if (cmd === 'ticket-kur') {
      if (!message.member.permissions.has(PermissionFlagsBits.Administrator))
        return message.reply('❌ Sadece yöneticiler ticket paneli kurabilir.');
      const embed = new EmbedBuilder()
        .setColor(CONFIG.COLOR)
        .setTitle('🎫 Viserion Destek Sistemi')
        .setDescription('Yetkililerle iletişime geçmek için aşağıdaki **Destek Talebi Oluştur** butonuna tıkla.');
      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId('create_ticket').setLabel('Destek Talebi Oluştur').setEmoji('🎫').setStyle(ButtonStyle.Primary)
      );
      return message.channel.send({ embeds: [embed], components: [row] });
    }
  } catch (err) {
    console.error(err);
    message.reply('❌ Komut çalıştırılırken bir hata oluştu.');
  }
});

