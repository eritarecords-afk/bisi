      await sendPartnerLog(
        interaction.guild,
        '🤝 Partner Duyurusu (/partner)',
        `**Yetkili:** ${interaction.user.tag}\n**Bugün/Hafta/Ay:** ${stats.today}/${stats.week}/${stats.month}\n**İçerik:** ${content}`
