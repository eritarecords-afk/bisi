    const val = interaction.values[0];
    const details = {
      partner: '🤝 **Partner & Blacklist:**\n`/partner`, `/kalici-partner` (Sadece Yönetici), `/blacklist-ekle`, `/blacklist-kaldir`, `/blacklist-liste`',
      mod: '🛡️ **Moderasyon:**\n`/ban`, `/kick`, `/warn`, `/clear`, `/ticket-kur` (ve `v!` karşılıkları)',
      eco: '💰 **Ekonomi & Seviye:**\n`/rank`, `/balance`, `/daily`, `/coinflip` (Mesaj attıkça otomatik XP kazanılır)',
      fun: '🎉 **Etkileşim:**\n`/poll <soru>` ile canlı butonlu anket, `/giveaway <saniye> <ödül>` ile çekiliş başlat.',
      info: 'ℹ️ **Bilgi & Embed:**\n`/ping`, `/userinfo`, `/serverinfo`, `/avatar`, `/embed`',
