        const y = [...votes.values()].filter(v => v === 'p_yes').length;
        const n = [...votes.values()].filter(v => v === 'p_no').length;
        await msg.edit({ components: [makeRow(y, n, true)] }).catch(() => {});
      });
    }

    if (commandName === 'giveaway') {
      const sec = interaction.options.getInteger('saniye');
      const prize = interaction.options.getString('odul');
      const participants = new Set();

      const embed = new EmbedBuilder()
        .setColor('#F1C40F')
        .setTitle('🎉 ÇEKİLİŞ BAŞLADI!')
        .setDescription(`**Ödül:** ${prize}\n**Bitiş:** <t:${Math.floor((Date.now() + sec * 1000) / 1000)}:R>\nKatılmak için aşağıdaki butona tıkla!`);
      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId('gw_join').setLabel('Katıl (0)').setEmoji('🎉').setStyle(ButtonStyle.Primary)
      );

      const msg = await interaction.reply({ embeds: [embed], components: [row], fetchReply: true });
      const collector = msg.createMessageComponentCollector({ componentType: ComponentType.Button, time: sec * 1000 });

      collector.on('collect', async i => {
        if (participants.has(i.user.id)) {
          return i.reply({ content: 'Zaten çekilişe katıldın!', ephemeral: true });
        }
        participants.add(i.user.id);
        const updatedRow = new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId('gw_join').setLabel(`Katıl (${participants.size})`).setEmoji('🎉').setStyle(ButtonStyle.Primary)
        );
        await i.update({ components: [updatedRow] });
      });

      collector.on('end', async () => {
        const list = [...participants];
        const winner = list.length ? `<@${list[Math.floor(Math.random() * list.length)]}>` : 'Katılımcı olmadı';
        const endEmbed = new EmbedBuilder()
          .setColor('#2ECC71')
          .setTitle('🎊 ÇEKİLİŞ SONA ERDİ!')
          .setDescription(`**Ödül:** ${prize}\n**Kazanan:** ${winner}`);
        await msg.edit({ embeds: [endEmbed], components: [] }).catch(() => {});
      });
    }

    if (commandName === 'ticket-kur') {
      const embed = new EmbedBuilder()
        .setColor(CONFIG.COLOR)
        .setTitle('🎫 Viserion Destek Sistemi')
        .setDescription('Yetkililerle iletişime geçmek için aşağıdaki **Destek Talebi Oluştur** butonuna tıkla.');
      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId('create_ticket').setLabel('Destek Talebi Oluştur').setEmoji('🎫').setStyle(ButtonStyle.Primary)
      );
      await interaction.channel.send({ embeds: [embed], components: [row] });
      return interaction.reply({ content: '✅ Ticket paneli kuruldu.', ephemeral: true });
    }
  } catch (err) {
    console.error(err);
    if (!interaction.replied) await interaction.reply({ content: '❌ Bir hata oluştu.', ephemeral: true });
  }
});

client.login(CONFIG.TOKEN);
