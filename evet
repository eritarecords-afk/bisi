// ==================== BELLEK İÇİ VERİTABANI ====================
const db = {
  xp: new Map(),                // userId -> { xp, level }
  economy: new Map(),           // userId -> { balance, lastDaily }
  warnings: new Map(),          // guildId_userId -> [ { reason, mod, date } ]
  partnerTimestamps: new Map(), // guildId_userId -> [ timestampMs, ... ]
  blacklist: new Map(),         // guildId -> Set(lowercaseTerm)
};

const getXP = (id) => {
  if (!db.xp.has(id)) db.xp.set(id, { xp: 0, level: 1 });
  return db.xp.get(id);
};

const getEco = (id) => {
  if (!db.economy.has(id)) db.economy.set(id, { balance: 100, lastDaily: 0 });
  return db.economy.get(id);
};

const getBlacklist = (guildId) => {
  if (!db.blacklist.has(guildId)) db.blacklist.set(guildId, new Set());
  return db.blacklist.get(guildId);
};

function recordPartnerAndGetStats(guildId, userId) {
  const key = `${guildId}_${userId}`;
  const now = Date.now();
  const list = db.partnerTimestamps.get(key) || [];
  list.push(now);
  db.partnerTimestamps.set(key, list);

  const startOfDay = new Date();
  startOfDay.setHours(0, 0, 0, 0);

  const day = new Date();
  const diffToMonday = (day.getDay() + 6) % 7;
  const startOfWeek = new Date(day);
  startOfWeek.setDate(day.getDate() - diffToMonday);
  startOfWeek.setHours(0, 0, 0, 0);

  const startOfMonth = new Date(day.getFullYear(), day.getMonth(), 1);

  return {
    today: list.filter(t => t >= startOfDay.getTime()).length,
    week: list.filter(t => t >= startOfWeek.getTime()).length,
    month: list.filter(t => t >= startOfMonth.getTime()).length,
    total: list.length,
  };
}

function findBlacklistedTerm(guildId, text) {
  const set = getBlacklist(guildId);
  const lower = text.toLowerCase();
  for (const term of set) {
    if (term && lower.includes(term)) return term;
  }
  return null;
}

function resolveChannel(guild, explicitId, keywords) {
  if (explicitId) {
    const byId = guild.channels.cache.get(explicitId);
    if (byId && byId.isTextBased()) return byId;
  }
  for (const kw of keywords) {
    const found = guild.channels.cache.find(
      c => c.isTextBased() && c.name.toLowerCase().includes(kw.toLowerCase())
    );
    if (found) return found;
  }
  return null;
}

function buildModernEmbed({ title, description, color, author, guildName, image, thumbnail, footerText }) {
  const hexRegex = /^#[0-9A-Fa-f]{6}$/;
  const safeColor = color && hexRegex.test(color) ? color : CONFIG.COLOR;

  const embed = new EmbedBuilder()
    .setColor(safeColor)
    .setTimestamp();

  if (title) embed.setTitle(title);
  if (description) embed.setDescription(description);
  if (author) {
    embed.setAuthor({
      name: author.username,
      iconURL: author.displayAvatarURL({ dynamic: true }),
    });
  }
  if (thumbnail && /^https?:\/\//i.test(thumbnail)) {
    embed.setThumbnail(thumbnail);
  }
  if (image && /^https?:\/\//i.test(image)) {
    embed.setImage(image);
  }
  embed.setFooter({
    text: footerText || `${guildName || 'Viserion'} • Viserion Modern Embed`,
  });

  return embed;
}

function buildPartnerAnnouncementEmbed(author, content, stats) {
  return new EmbedBuilder()
    .setColor('#E91E63')
    .setAuthor({
      name: `${author.username} • Yeni Partnerlik`,
      iconURL: author.displayAvatarURL({ dynamic: true }),
    })
    .setDescription(content)
    .addFields(
      { name: '📅 Bugün', value: `\`${stats.today}\` partner`, inline: true },
      { name: '📆 Bu Hafta', value: `\`${stats.week}\` partner`, inline: true },
      { name: '🗓️ Bu Ay', value: `\`${stats.month}\` partner`, inline: true }
    )
    .setFooter({ text: `Partneri Yapan: ${author.tag} • Toplam: ${stats.total}` })
    .setTimestamp();
}

function buildPermanentPartnerEmbed(author, content) {
  return new EmbedBuilder()
    .setColor('#F1C40F')
    .setTitle('💎 Kalıcı Partnerlik')
    .setDescription(content)
    .setAuthor({
      name: author.username,
      iconURL: author.displayAvatarURL({ dynamic: true }),
    })
    .setFooter({ text: `Yönetici Onaylı Kalıcı Partner • ${author.tag}` })
    .setTimestamp();
}

