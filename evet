        await sendPartnerLog(
          interaction.guild,
          '🚫 Blacklist Engellendi (/partner)',
          `**Kullanıcı:** ${interaction.user.tag}\n**Eşleşen Kayıt:** \`${blockedTerm}\`\n**İçerik:** ${content}`,
          '#E74C3C'
        );
        return interaction.reply({ content: `🚫 **\`${blockedTerm}\`** blacklist'te bulunduğu için bu partner gönderilemez!`, ephemeral: true });
      }

      const partnerCh = resolveChannel(interaction.guild, CONFIG.CHANNELS.PARTNER_ID, ['partnerler']) || interaction.channel;
      const stats = recordPartnerAndGetStats(interaction.guild.id, interaction.user.id);
