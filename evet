async function sendLog(guild, title, description, color = '#E67E22') {
  const logCh = guild.channels.cache.find(c => c.name === CONFIG.LOG_CHANNEL_NAME && c.isTextBased());
  if (!logCh) return;
  const embed = new EmbedBuilder().setColor(color).setTitle(title).setDescription(description).setTimestamp();
  await logCh.send({ embeds: [embed] }).catch(() => {});
}

async function sendPartnerLog(guild, title, description, color = '#E91E63') {
  const pLogCh = resolveChannel(guild, CONFIG.CHANNELS.PARTNER_LOG_ID, ['partner', 'log']);
  if (!pLogCh) return;
  const embed = new EmbedBuilder().setColor(color).setTitle(title).setDescription(description).setTimestamp();
  await pLogCh.send({ embeds: [embed] }).catch(() => {});
}

